# Variables d'environnement — PNC Command Center
# ============================================================
# Copiez ce fichier en .env.local et remplissez les valeurs.
# En mode développement (sandbox), le backend NestJS utilise PGlite
# (PostgreSQL embarqué, aucune installation serveur requise).
# En production, connectez un vrai serveur PostgreSQL + extension PostGIS.

# ============================================================================
# MODE BACKEND
# ============================================================================
# "supabase" | "local" | "nestjs"
# En mode nestjs (recommandé), le frontend appelle le backend NestJS sur le port 3001
PNC_BACKEND_MODE=nestjs

# ============================================================================
# BACKEND NESTJS (port 3001)
# ============================================================================
# URL du backend NestJS (les appels passent par la gateway Caddy avec XTransformPort)
NEXT_PUBLIC_NESTJS_URL=/api
NEXT_PUBLIC_NESTJS_PORT=3001

# ============================================================================
# POSTGRESQL / POSTGIS (backend NestJS)
# ============================================================================
# En développement : laissez vide → PGlite (PostgreSQL embarqué, fichier local)
# En production : chaîne de connexion vers un vrai serveur PostgreSQL + PostGIS
# Exemple : postgresql://pnc:password@localhost:5432/pnc_command
DATABASE_URL=

# Active PostGIS pour les requêtes spatiales avancées (requiert un vrai PostgreSQL)
POSTGIS_ENABLED=false

# ============================================================================
# SOFT STORAGE (photos, preuves)
# ============================================================================
# Répertoire local pour stocker les fichiers téléversés (mode dev)
UPLOAD_DIR=./uploads

# ============================================================================
# AUTHENTIFICATION
# ============================================================================
# Secret pour signer les tokens JWT (en production, utilisez une chaîne aléatoire de 64+ caractères)
JWT_SECRET=change-me-in-production-use-a-random-64-char-string

# Durée de validité du token (en secondes) — défaut: 86400 (24h)
JWT_EXPIRES_IN=86400

# ============================================================================
# CARTE (Maplibre GL)
# ============================================================================
# Tuiles OpenStreetMap (gratuit, aucune clé API)
# Pour un usage intensif, utilisez MapTiler ou Stadia Maps (clé API requise)
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ============================================================================
# TEMPS RÉEL (Socket.io)
# ============================================================================
# Port du serveur Socket.io (géré par le backend NestJS)
SOCKET_IO_PORT=3001

# ============================================================================
# MODE SUPERBASE (LÉGACY — non recommandé pour la nouvelle archi)
# ============================================================================
# Pour rétro-compatibilité avec l'ancienne intégration Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_EVIDENCE_BUCKET=pnc-evidence
